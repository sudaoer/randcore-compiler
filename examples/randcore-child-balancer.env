# Root PIDs are not managed themselves. The service scans their descendants.
# Example: set this to the PID of make, ninja, cmake, or another build driver.
RANDCORE_PARENT_PIDS=

# Matching stops independent scheduling at the first managed process. When that
# process is routed to A100, the visible subtree is marked with the same HMP flag.
RANDCORE_MATCH_NAMES=*gcc,*g++,gcc,g++,cc,c++,clang,clang++

RANDCORE_SCAN_INTERVAL_MS=100
RANDCORE_SET_AI_THREAD=/proc/set_ai_thread
RANDCORE_LOG=0
RANDCORE_STRICT=0
RANDCORE_DRY_RUN=0
